                <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        const toggles = document.querySelectorAll('.content-toggle');
                        const blocks = document.querySelectorAll('.content-block');

                        function updateToggleStyles(toggle, isActive) {
                            const heading = toggle.querySelector('h4');
                            const paragraph = toggle.querySelector('p');
                            const image = toggle.querySelector('img');
                            
                            if (isActive) {
                                toggle.style.backgroundColor = '#FFFFFF';
                                heading.style.color = '#213C8D';
                                paragraph.style.color = '#213C8D';
                                image.style.backgroundColor = '#213C8D';
                                toggle.classList.add('active');
                            } else {
                                toggle.style.backgroundColor = '#213C8D';
                                heading.style.color = '#FFFFFF';
                                paragraph.style.color = '#FFFFFF'; 
                                image.style.backgroundColor = '#FFFFFF';
                                toggle.classList.remove('active');
                            }
                        }

                        function showContent(targetId) {
                            blocks.forEach(block => {
                                block.style.display = block.id === targetId ? 'block' : 'none';
                            });
                        }

                        toggles.forEach(toggle => {
                            toggle.addEventListener('click', function() {
                                const targetId = this.getAttribute('data-target');
                                
                                toggles.forEach(t => {
                                    updateToggleStyles(t, t === this);
                                });
                                
                                showContent(targetId);
                            });
                        });

                        // Initialize first content block as active
                        showContent('ct_1');
                    });
                </script>

